# Cloudflare Pages header rules.
#
# sw.js must never be served from a cache. Browsers re-check the service worker
# script on navigation, and that check is the only mechanism by which a fixed -
# or deliberately self-destructing - worker reaches devices that already have
# one installed. A cached sw.js means a stuck sw.js, and no way to recover
# except waiting for the cache to expire.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.json
  Cache-Control: no-cache

# Offline artefacts are immutable once built: each build writes new filenames.
/offline/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
